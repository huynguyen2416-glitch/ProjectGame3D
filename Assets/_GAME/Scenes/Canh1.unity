--- !u!114 &686412245
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 686412243}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.15686275, g: 0.15686275, b: 0.15686275, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: d3418a48cdc42d24980345c46a6ede92, type: 3}
    m_FontSize: 8
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Cu\u1ED1n s\u1ED5 tay n\xE0y \u0111\xF3ng vai tr\xF2 nh\u01B0 m\u1ED9t
    kho l\u01B0u tr\u1EEF tri th\u1EE9c t\u1ED5ng h\u1EE3p, ghi ch\xE9p l\u1EA1i
    nh\u1EEFng ph\u01B0\u01A1ng th\u1EE9c sinh t\u1ED3n \u0111\u01B0\u1EE3c l\u01B0u
    truy\u1EC1n nhi\u1EC1u th\u1EBF h\u1EC7. \u0110\xE2y kh\xF4ng ch\u1EC9 l\xE0
    t\xE0i li\u1EC7u h\u01B0\u1EDBng d\u1EABn c\u01A1 b\u1EA3n m\xE0 c\xF2n l\xE0
    ch\xECa kh\xF3a then ch\u1ED1t gi\xFAp b\u1EA1n khai ph\xE1 nh\u1EEFng gi\u1EDBi
    h\u1EA1n ti\u1EC1m \u1EA9n c\u1EE7a b\u1EA3n th\xE2n khi \u0111\u1ED1i m\u1EB7t
    v\u1EDBi m\xF4i tr\u01B0\u1EDDng t\u1EF1 nhi\xEAn kh\u1EAFc nghi\u1EC7t.\n\nXuy\xEAn
    su\u1ED1t cu\u1ED9c h\xE0nh tr\xECnh, m\u1ECDi n\u1ED7 l\u1EF1c c\u1EE7a b\u1EA1n
    \u0111\u1EC1u s\u1EBD \u0111\u01B0\u1EE3c \u0111\u1EC1n \u0111\xE1p. M\u1ED7i
    khi th\u1EF1c hi\u1EC7n c\xE1c h\xE0nh \u0111\u1ED9ng t\u01B0\u01A1ng t\xE1c
    v\u1EDBi th\u1EBF gi\u1EDBi xung quanh (nh\u01B0 thu th\u1EADp, khai th\xE1c
    t\xE0i nguy\xEAn) hay ti\u1EBFn h\xE0nh ch\u1EBF t\u1EA1o v\u1EADt ph\u1EA9m,
    b\u1EA1n s\u1EBD t\xEDch l\u0169y \u0111\u01B0\u1EE3c \u0110i\u1EC3m Sinh T\u1ED3n.
    Ngu\u1ED3n \u0111i\u1EC3m s\u1ED1 qu\xFD gi\xE1 n\xE0y ch\xEDnh l\xE0 nguy\xEAn
    li\u1EC7u c\u1ED1t l\xF5i \u0111\u1EC3 th\u0103ng c\u1EA5p v\xE0 m\u1EDF kh\xF3a
    h\u1EC7 th\u1ED1ng ph\xE1t tri\u1EC3n n\u0103ng l\u1EF1c c\xE1 nh\xE2n, v\u1ED1n
    \u0111\u01B0\u1EE3c ph\xE2n chia th\xE0nh hai nh\xE1nh ch\xEDnh:\n\nL\xFD Tr\xED:
    C\u1EA3i thi\u1EC7n hi\u1EC7u su\u1EA5t thu th\u1EADp t\xE0i nguy\xEAn, t\u0103ng
    t\u1ED1c \u0111\u1ED9 ch\u1EBF t\u1EA1o c\xF4ng c\u1EE5 v\xE0 gi\xFAp b\u1EA1n
    d\u1EC5 d\xE0ng t\xECm th\u1EA5y c\xE1c v\u1EADt ph\u1EA9m qu\xFD hi\u1EBFm h\u01A1n.\nSinh
    T\u1ED3n: T\u0103ng c\u01B0\u1EDDng n\u1EC1n t\u1EA3ng th\u1EC3 ch\u1EA5t, tr\u1EF1c
    ti\u1EBFp m\u1EDF r\u1ED9ng gi\u1EDBi h\u1EA1n l\u01B0\u1EE3ng m\xE1u, th\u1EC3
    l\u1EF1c v\xE0 s\u1EE9c b\u1EC1n \u0111\u1EC3 ch\u1ED1ng ch\u1ECDi l\u1EA1i v\u1EDBi
    \xE1p l\u1EF1c ngo\u1EA1i c\u1EA3nh.\n\nKhi \u0111\xE3 t\xEDch l\u0169y \u0111\u1EE7
    \u0110i\u1EC3m Sinh T\u1ED3n, \u0111\u1EC3 ti\u1EBFn h\xE0nh nghi\xEAn c\u1EE9u
    v\xE0 \u0111\u1ECBnh h\xECnh h\u01B0\u1EDBng ph\xE1t tri\u1EC3n, xin vui l\xF2ng
    t\u01B0\u01A1ng t\xE1c v\u1EDBi c\xE1c d\u1EA3i ruy b\u0103ng \u0111\xE1nh d\u1EA5u
    trang \u0111\u1EC3 bi\u1EBFt th\xEAm chi ti\u1EBFt."
