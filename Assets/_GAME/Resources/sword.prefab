  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InventoryItem
  thisName: "\"Ki\u1EBFm Th\xE1nh\""
  thisDescription: "\"Thanh \u0111\u1EA1i ki\u1EBFm \u0111\u01B0\u1EE3c \u0111\xFAc
    t\u1EEB m\u1EA3nh di v\u1EADt M\u1EB7t Tr\u0103ng c\u1ED5 \u0111\u1EA1i, r\xE8n
    qua tr\u0103m ng\u1ECDn l\u1EEDa tr\u1EA1i v\xE0 t\u1EAFm trong \xE1nh b\xECnh
    minh c\u1EE7a ng\xE0y sinh t\u1ED3n cu\u1ED1i c\xF9ng. L\u01B0\u1EE1i ki\u1EBFm
    t\u1ECFa ra th\u1EE9 \xE1nh s\xE1ng thu\u1EA7n khi\u1EBFt, th\u1EE9v\u0169 kh\xED
    duy nh\u1EA5t c\xF3 th\u1EC3 xuy\xEAn th\u1EE7ng m\xE0n \u0111\xEAm v\xF4 t\u1EADn
    v\xE0 k\u1EBFt li\u1EC5u th\u1EF1c th\u1EC3 b\xF3ng t\u1ED1i t\u1EADn c\xF9ng.\""
  thisFunctionality: "C\xF3 th\u1EC3 ch\u1EBF t\u1EA1o [C]"
  isTrashable: 1
