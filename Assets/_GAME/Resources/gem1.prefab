  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InventoryItem
  thisName: "Th\u1EA1ch \u1EA4n \"Kh\u1EDFi Nguy\xEAn\""
  thisDescription: "\"Trong c\xE1c ghi ch\xE9p \u1EDF Bi\u1EC3n Ch\u1EBFt, kh\u1ED1i
    thi\xEAn th\u1EA1ch n\xE0y \u0111\u01B0\u1EE3c g\u1ECDi l\xE0 'Ng\xE0y \u0110\u1EA7u
    Ti\xEAn' \u2014 t\xE0n t\xEDch c\u1EE7a th\u1EE9 \xE1nh s\xE1ng \u0111\xE3 x\xE9
    to\u1EA1c b\xF3ng t\u1ED1i nguy\xEAn th\u1EE7y. L\xE0 m\u1ED9t nh\xE0 kh\u1EA3o
    c\u1ED5, b\u1EA1n nh\u1EADn ra b\u1EC1 m\u1EB7t c\u1EE7a n\xF3 kh\xF4ng ph\u1EA3i
    \u0111\xE1, m\xE0 l\xE0 m\u1ED9t kh\u1ED1i h\u1EE3p kim t\u1EEB v\u0169 tr\u1EE5
    ch\u01B0a t\u1EEBng b\u1ECB r\u1EC9 s\xE9t sau h\xE0ng thi\xEAn ni\xEAn k\u1EF7.\""
  thisFunctionality: "C\xF3 th\u1EC3 ch\u1EBF t\u1EA1o \"Ki\u1EBFm Th\xE1nh\""
